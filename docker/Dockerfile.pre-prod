FROM node:20-bullseye

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 ffmpeg libtool-bin make htop ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN wget https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -O /usr/local/bin/yt-dlp && chmod a+rx /usr/local/bin/yt-dlp
RUN ln -sf python3 /usr/bin/python

WORKDIR /app

COPY ./package.json ./
# Yarn lock removed; npm will use package-lock.json if present
# COPY ./yarn.lock ./

ENV YOUTUBE_DL_SKIP_DOWNLOAD=true
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
RUN npm run build

ENTRYPOINT ["/bin/sh"]

CMD ["-c", "node dist/main"]
