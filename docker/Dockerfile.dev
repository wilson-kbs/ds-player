FROM node:22-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential autoconf automake libtool libtool-bin \
    python3 python3-pip ffmpeg htop git curl bash ca-certificates \
  && ln -sf python3 /usr/bin/python \
  && rm -rf /var/lib/apt/lists/*
# Install yt-dlp using the repository script
COPY scripts/install_yt_dlp.sh /usr/local/bin/install_yt_dlp.sh
RUN bash /usr/local/bin/install_yt_dlp.sh /usr/local/bin
RUN npm i -g node-gyp@10

WORKDIR /app

VOLUME /data

ENTRYPOINT ["/bin/sh"]
