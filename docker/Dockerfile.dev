FROM node:20-bullseye

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg libtool make htop git curl bash ca-certificates \
  && rm -rf /var/lib/apt/lists/*
# Install yt-dlp using the repository script
COPY scripts/install_yt_dlp.sh /usr/local/bin/install_yt_dlp.sh
RUN bash /usr/local/bin/install_yt_dlp.sh /usr/local/bin
RUN npm i -g node-gyp@9

WORKDIR /app

VOLUME /data

ENTRYPOINT ["/bin/sh"]
